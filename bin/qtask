#!/bin/bash
# qtask — corre tareas de agente contra el modelo LOCAL, con servidor persistente
#         y reintentos que conservan el contexto de la sesion.
#
#   qtask status                     estado del modelo + servidor
#   qtask doctor                     diagnostica y repara (runner zombi, OOM de GPU)
#   qtask warm | unload              carga / libera los ~13 GB del modelo
#   qtask serve | stop | logs        servidor opencode persistente (puerto 4097)
#   qtask run "<tarea>"              tarea nueva (reintenta hasta 3 veces)
#   qtask cont "<seguimiento>"       continua la ultima sesion de este directorio
#   qtask tui                        abre la TUI ya apuntando al modelo local
#   qtask web                        abre la interfaz web
#   qtask queue <archivo>            cola reanudable: lista plana (una tarea por
#                                    linea) o un plan .md (extrae los items)
#   qtask sessions [texto]           lista sesiones (fecha/carpeta/titulo)
#
# Variables: QWEN_MODEL (default qwen35-code:latest), QTASK_RETRIES (3),
#            QTASK_MAX_SECS (900, techo por intento), QTASK_PORT (4097),
#            QTASK_AGENT (local)

set -uo pipefail

# opencode (sobre todo `web` y `tui`) vigila muchos archivos a la vez y agota
# los descriptores si la terminal arranca con un limite bajo. Warp abre con
# ~2560 y revienta con "low max file descriptors". El techo duro en macOS suele
# ser ilimitado, asi que subimos el limite blando aqui sin sudo. Silencioso si
# la terminal ya venia holgada.
raise_fd_limit() {
  local cur; cur=$(ulimit -Sn)
  [ "$cur" = "unlimited" ] && return
  [ "$cur" -ge 61440 ] 2>/dev/null && return
  for want in 262144 65536 30000 10240; do
    ulimit -Sn "$want" 2>/dev/null && break
  done
}
raise_fd_limit

MODEL_REF="local-ollama/${QWEN_MODEL:-qwen35-code:latest}"
OLLAMA="${OLLAMA_HOST:-http://127.0.0.1:11434}"
PORT="${QTASK_PORT:-4097}"
SERVER="http://127.0.0.1:$PORT"
RETRIES="${QTASK_RETRIES:-3}"
# Techo de tiempo por intento. Un modelo local que se queda sin contexto entra
# en bucle: repite tool-calls sin terminar nunca (en pruebas, un solo `run`
# corrio 2.4 h). Sin este techo nada lo corta. 900s cubre tareas legitimas
# lentas y mata las patologicas.
MAX_SECS="${QTASK_MAX_SECS:-900}"
AGENT="${QTASK_AGENT:-local}"
STATE="$HOME/.qwen-local"
PLIST="$HOME/Library/LaunchAgents/local.opencode.server.plist"
PASSFILE="$STATE/server-pass"
mkdir -p "$STATE/logs"

# El servidor puede ejecutar bash arbitrario, asi que va con basic-auth aunque
# solo escuche en 127.0.0.1 (protege contra otras apps locales y DNS rebinding).
if [ ! -s "$PASSFILE" ]; then
  ( umask 077; head -c 32 /dev/urandom | shasum -a 256 | cut -c1-32 > "$PASSFILE" )
fi
PASS="$(cat "$PASSFILE")"
USER_="opencode"

c_dim=$'\033[2m'; c_red=$'\033[31m'; c_grn=$'\033[32m'; c_yel=$'\033[33m'; c_off=$'\033[0m'
say() { echo "${c_dim}qtask${c_off} $*"; }

server_up() { curl -sf --max-time 2 -u "$USER_:$PASS" "$SERVER/config" >/dev/null 2>&1; }

model_loaded() {
  curl -sf --max-time 3 "$OLLAMA/api/ps" 2>/dev/null \
    | grep -q "\"${QWEN_MODEL:-qwen35-code:latest}\""
}

# ¿el modelo GENERA de verdad? Estar cargado no basta: tras un OOM de GPU el
# runner queda zombi y responde vacio al instante (eval_count 0) con HTTP 200.
model_generates() {
  curl -sf --max-time 60 "$OLLAMA/api/chat" -H 'Content-Type: application/json' \
    -d "{\"model\":\"${QWEN_MODEL:-qwen35-code:latest}\",\"messages\":[{\"role\":\"user\",\"content\":\"ok\"}],\"stream\":false,\"think\":false,\"keep_alive\":-1,\"options\":{\"num_predict\":4}}" \
    2>/dev/null | grep -q '"eval_count":[1-9]'
}

ensure_model() {
  if ! model_loaded; then
    say "modelo frio, precargando…"
    bash "$STATE/keeper.sh"
  elif ! model_generates; then
    # cargado pero zombi: keeper.sh mata el runner y lo recrea
    say "${c_yel}modelo no responde (zombi), reparando…${c_off}"
    bash "$STATE/keeper.sh"
  fi
}

# Ejecuta opencode; usa el servidor persistente si esta arriba.
oc_run() {
  local extra=()
  server_up && extra+=(--attach "$SERVER" --dir "$PWD" -u "$USER_" -p "$PASS")
  # ${extra[@]+...}: el bash 3.2 de macOS trata una array vacia bajo `set -u`
  # como variable sin definir y aborta. Sin servidor, extra esta vacia.
  # stdin desde /dev/null: si no, opencode se traga el stdin del bucle
  # `while read` de cmd_queue y la cola se salta las tareas restantes.
  opencode run --auto --agent "$AGENT" -m "$MODEL_REF" \
    ${extra[@]+"${extra[@]}"} "$@" </dev/null
}

# Reinicia el servidor persistente en el sitio. Cuando un intento se cuelga
# estando ADJUNTO al servidor, matar el cliente no basta: el trabajo sigue en
# el servidor. Esto tumba la sesion desbocada y deja el servidor limpio.
server_bounce() {
  launchctl kickstart -k "gui/$(id -u)/local.opencode.server" 2>/dev/null || return
  for _ in $(seq 1 30); do server_up && break; sleep 1; done
}

# Corre "$@" con un techo de tiempo (MAX_SECS). Si se pasa, mata el arbol de
# procesos y devuelve 124 (como `timeout`, que macOS no trae). Un vigia en
# segundo plano marca un flag y manda TERM y luego KILL.
run_bounded() {
  local flag; flag="$STATE/.timeout.$$"
  rm -f "$flag"
  "$@" &
  local pid=$!
  ( sleep "$MAX_SECS"
    kill -0 "$pid" 2>/dev/null || exit
    : > "$flag"
    pkill -TERM -P "$pid" 2>/dev/null; kill -TERM "$pid" 2>/dev/null
    sleep 3
    pkill -KILL -P "$pid" 2>/dev/null; kill -KILL "$pid" 2>/dev/null
  ) &
  local wd=$!
  wait "$pid"; local rc=$?
  kill "$wd" 2>/dev/null; wait "$wd" 2>/dev/null
  if [ -f "$flag" ]; then rm -f "$flag"; return 124; fi
  return "$rc"
}

cmd_status() {
  echo
  if curl -sf --max-time 3 "$OLLAMA/api/version" >/dev/null 2>&1; then
    echo "  ollama    ${c_grn}arriba${c_off}  $OLLAMA"
  else
    echo "  ollama    ${c_red}caido${c_off}"
  fi
  QWEN_MODEL="${QWEN_MODEL:-qwen35-code:latest}" curl -sf --max-time 3 "$OLLAMA/api/ps" 2>/dev/null | QWEN_MODEL="${QWEN_MODEL:-qwen35-code:latest}" python3 -c '
import json, os, sys
want = os.environ["QWEN_MODEL"]
try: d = json.load(sys.stdin)
except Exception: sys.exit()
if not d.get("models"):
    print("  modelo    \033[33mno residente\033[0m (corre: qtask warm)"); sys.exit()
for m in d["models"]:
    exp = m.get("expires_at", "")[:4]
    forever = exp.isdigit() and int(exp) > 2100
    print("  modelo    \033[32m%s\033[0m  ctx %s · %.1f GB · %s" % (
        m["name"], m.get("context_length", "?"), m["size_vram"] / 1e9,
        "\033[32mresidente para siempre\033[0m" if forever else "\033[33mexpira " + m.get("expires_at", "?")[:19] + "\033[0m"))
    # Solo cabe un modelo a la vez: si el residente no es el tuyo, alguien lo
    # desalojo (la Ollama.app, un `ollama run` suelto...). La proxima tarea
    # pagaria recarga, o peor, reventaria si ese modelo no cabe en la GPU.
    if m["name"] != want:
        print("            \033[33m^ no es el configurado (%s) — corre: qtask warm\033[0m" % want)
'
  if server_up; then
    echo "  servidor  ${c_grn}arriba${c_off}  $SERVER"
  else
    echo "  servidor  ${c_yel}abajo${c_off}   (corre: qtask serve)"
  fi
  echo "  agente    $AGENT · $MODEL_REF"
  local fd; fd=$(ulimit -Sn)
  if [ "$fd" != "unlimited" ] && [ "$fd" -lt 10240 ] 2>/dev/null; then
    echo "  fd limit  ${c_yel}$fd (bajo — qtask lo sube solo al lanzar)${c_off}"
  fi
  echo
}

cmd_warm() { ensure_model; cmd_status; }

# Lista las sesiones directamente de la base de opencode: fecha, carpeta y
# titulo. Asi las ubicas aunque el web las agrupe por directorio.
#   qtask sessions            ultimas 25
#   qtask sessions <texto>    filtra por carpeta o titulo
cmd_sessions() {
  local db="$HOME/.local/share/opencode/opencode.db"
  [ -f "$db" ] || { opencode session list; return; }
  local filter="${1:-}"
  # copia para no chocar con el WAL del servidor vivo
  local tmp; tmp="$STATE/.sessions.db"
  cp "$db" "$tmp" 2>/dev/null || { opencode session list; return; }
  FILTER="$filter" HOME_="$HOME" python3 - "$tmp" <<'PY'
import sqlite3, os, sys, datetime
db, flt = sys.argv[1], os.environ.get("FILTER", "").lower()
home = os.environ["HOME_"]
con = sqlite3.connect(db)
rows = con.execute("SELECT time_created, directory, title FROM session ORDER BY time_created DESC").fetchall()
seen = 0
print("\n  \033[2mfecha              carpeta / titulo\033[0m")
for ts, d, title in rows:
    d = d or ""; title = (title or "").strip().replace("\n", " ")
    if flt and flt not in d.lower() and flt not in title.lower():
        continue
    when = datetime.datetime.fromtimestamp(ts/1000).strftime("%Y-%m-%d %H:%M")
    short = d.replace(home, "~")
    print(f"  {when}  \033[36m{short}\033[0m")
    print(f"                     {title[:70]}")
    seen += 1
    if seen >= 25: break
print(f"\n  {seen} sesiones" + (f" que coinciden con '{flt}'" if flt else " (las 25 mas recientes)"))
print("  \033[2mabrir una:  cd <carpeta> && qtask tui\033[0m\n")
PY
  rm -f "$tmp"
}

cmd_unload() {
  # Libera los ~13 GB sin apagar ollama (para compilar, editar video, etc.)
  curl -sf --max-time 10 "$OLLAMA/api/chat" -H 'Content-Type: application/json' \
    -d "{\"model\":\"${QWEN_MODEL:-qwen35-code:latest}\",\"messages\":[],\"keep_alive\":0}" >/dev/null
  say "modelo descargado de memoria (vuelve con: qtask warm)"
}

cmd_doctor() {
  cmd_status
  say "probando generacion real…"
  local out; out=$(curl -sf --max-time 120 "$OLLAMA/api/chat" -H 'Content-Type: application/json' \
    -d "{\"model\":\"${QWEN_MODEL:-qwen35-code:latest}\",\"messages\":[{\"role\":\"user\",\"content\":\"di OK\"}],\"stream\":false,\"think\":false,\"options\":{\"num_predict\":8}}")
  if echo "$out" | grep -q '"eval_count":[1-9]'; then
    say "${c_grn}genera bien${c_off}"
  else
    say "${c_red}respuesta vacia — runner zombi${c_off}; reparando"
    bash "$STATE/keeper.sh"
    tail -3 "$STATE/logs/keeper.log"
    echo
    say "si persiste, la causa suele ser memoria de GPU. Ultimas lineas de ollama:"
    grep -iE "OutOfMemory|failed to decode|Compute error" ~/.ollama/logs/server.log 2>/dev/null | tail -3
  fi
}

cmd_serve() {
  cat > "$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>local.opencode.server</string>
    <key>ProgramArguments</key>
    <array>
        <string>$(command -v opencode)</string>
        <string>serve</string>
        <string>--port</string><string>$PORT</string>
        <string>--hostname</string><string>127.0.0.1</string>
        <string>--print-logs</string>
        <string>--log-level</string><string>INFO</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <!-- El maxfiles global de launchd es 256; el watcher de opencode necesita
         mucho mas o muere con "low max file descriptors". -->
    <key>SoftResourceLimits</key><dict>
        <key>NumberOfFiles</key><integer>65536</integer>
    </dict>
    <key>HardResourceLimits</key><dict>
        <key>NumberOfFiles</key><integer>65536</integer>
    </dict>
    <key>WorkingDirectory</key><string>$HOME</string>
    <key>StandardOutPath</key><string>$STATE/logs/opencode-server.log</string>
    <key>StandardErrorPath</key><string>$STATE/logs/opencode-server.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>$PATH</string>
        <key>OPENCODE_SERVER_USERNAME</key><string>$USER_</string>
        <key>OPENCODE_SERVER_PASSWORD</key><string>$PASS</string>
    </dict>
</dict>
</plist>
PL
  chmod 600 "$PLIST"
  launchctl bootout "gui/$(id -u)/local.opencode.server" 2>/dev/null
  # launchd a veces devuelve I/O error si el bootout anterior aun se esta
  # asentando; reintentar un par de veces lo resuelve.
  for i in 1 2 3; do
    sleep 2
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null && break
    [ "$i" = 3 ] && { echo "no pude cargar el LaunchAgent" >&2; exit 1; }
  done
  say "esperando al servidor…"
  for _ in $(seq 1 30); do server_up && break; sleep 1; done
  ensure_model
  cmd_status
}

cmd_stop() {
  launchctl bootout "gui/$(id -u)/local.opencode.server" 2>/dev/null
  say "servidor detenido (el modelo sigue residente)"
}

# --- nucleo: correr una tarea con reintentos que conservan contexto ----------
run_with_retries() {
  local mode="$1"; shift          # "new" | "cont"
  local prompt="$*"
  ensure_model

  local attempt=1
  while [ "$attempt" -le "$RETRIES" ]; do
    local started; started=$(date +%s)
    say "intento $attempt/$RETRIES · $(date '+%H:%M:%S')"

    if [ "$attempt" -gt 1 ] || [ "$mode" = "cont" ]; then
      # Reintento: --continue reengancha la MISMA sesion, asi que el modelo
      # conserva todo lo que ya hizo en vez de empezar de cero.
      run_bounded oc_run --continue "$prompt"
    else
      run_bounded oc_run --title "$(echo "$prompt" | cut -c1-60)" "$prompt"
    fi
    local rc=$?

    local secs=$(( $(date +%s) - started ))
    # rc 124 = paso el techo de tiempo: el modelo entro en bucle (tipico al
    # quedarse sin contexto). Adjunto al servidor, hay que reiniciarlo para
    # matar la sesion desbocada, no solo el cliente.
    if [ "$rc" -eq 124 ]; then
      say "${c_red}colgado >${MAX_SECS}s${c_off} (probable bucle por falta de contexto), cortado"
      server_up && { say "reiniciando servidor para tumbar la sesion desbocada…"; server_bounce; }
    fi
    # rc 0 + duracion irrisoria = el runner devolvio vacio (zombi por OOM):
    # opencode sale al instante sin llamar herramientas y aparenta exito.
    if [ "$rc" -eq 0 ] && [ "$secs" -lt 3 ] && ! model_generates; then
      say "${c_yel}salida vacia en ${secs}s (modelo zombi), no cuenta${c_off}"
      rc=99
    fi
    if [ "$rc" -eq 0 ]; then
      say "${c_grn}listo${c_off} en ${secs}s"
      echo "$(date '+%F %T') OK ${secs}s :: $prompt" >> "$STATE/logs/qtask.log"
      return 0
    fi

    say "${c_red}fallo${c_off} (rc=$rc) tras ${secs}s"
    echo "$(date '+%F %T') FAIL rc=$rc ${secs}s :: $prompt" >> "$STATE/logs/qtask.log"
    # Si murio por el modelo caido, revivelo antes de reintentar.
    ensure_model
    attempt=$(( attempt + 1 ))
    [ "$attempt" -le "$RETRIES" ] && { say "reintentando en 5s…"; sleep 5; }
    prompt="Continua donde te quedaste. La ejecucion anterior se interrumpio; revisa el estado real de los archivos antes de seguir."
  done

  say "${c_red}se agotaron los $RETRIES intentos${c_off}"
  return 1
}

# ¿el archivo es un plan en Markdown (y no una lista plana de tareas)?
# Dispara SOLO con estructura inequivoca de documento: tablas, bloques de
# codigo, citas o checklists. A proposito NO usa titulos '#': en el formato
# plano de siempre '#' es un comentario, y confundirlo mandaria una lista
# legitima al parser de plan y descartaria sus tareas.
looks_like_markdown() {
  grep -qE '^[[:space:]]*(>|\||`{3}|~{3})|^[[:space:]]*[-*+][[:space:]]+\[[ xX]\]' "$1"
}

# Extrae de un plan en Markdown SOLO los items accionables, una tarea por
# linea, sin el marcador. Ignora titulos, tablas, citas, reglas, bloques ```
# y arte ASCII. Los checklists ya marcados (- [x]) se saltan.
extract_plan_items() {
  awk '
    { line = $0 }
    line ~ /^[[:space:]]*(```|~~~)/ { infence = !infence; next }
    infence { next }
    { s = line; sub(/^[[:space:]]+/, "", s) }
    s == "" { next }
    s ~ /^[-*+][[:space:]]+\[[xX]\]/ { next }                                   # checklist hecho
    s ~ /^[-*+][[:space:]]+\[[[:space:]]\][[:space:]]+/ {                       # checklist pendiente
      sub(/^[-*+][[:space:]]+\[[[:space:]]\][[:space:]]+/, "", s); print s; next }
    s ~ /^[-*+][[:space:]]+/    { sub(/^[-*+][[:space:]]+/, "", s); print s; next }   # vineta
    s ~ /^[0-9]+[.)][[:space:]]+/ { sub(/^[0-9]+[.)][[:space:]]+/, "", s); print s; next }  # lista ordenada
    # todo lo demas (titulos, tablas, citas, reglas, prosa, arte) se ignora
  ' "$1"
}

cmd_queue() {
  local file="$1"
  [ -f "$file" ] || { echo "no existe: $file" >&2; return 1; }

  # Normaliza el archivo a una tarea por linea antes de correr nada.
  #   - Lista plana: una tarea imperativa por linea (comportamiento de siempre).
  #   - Plan en Markdown: se extraen SOLO los items accionables (- [ ], -, 1.).
  # Sin esto, un .md se troceaba por lineas y el agente intentaba "ejecutar"
  # filas de tabla, titulos y prosa: se quedaba sin contexto (16K) y entraba en
  # bucle sin pasar del plan. Ver qtask.log si dudas de por que se te colgo.
  local tasks_file; tasks_file="$STATE/.queue-tasks.$$"
  if looks_like_markdown "$file"; then
    extract_plan_items "$file" > "$tasks_file"
    if [ ! -s "$tasks_file" ]; then
      rm -f "$tasks_file"
      echo "qtask: '$file' parece Markdown pero no tiene items accionables." >&2
      echo "       Escribe los pasos como lista ('- haz X' o '1. haz Y'), o pasa" >&2
      echo "       un texto plano con una tarea imperativa por linea." >&2
      return 1
    fi
    say "plan en Markdown: extraje $(wc -l < "$tasks_file" | tr -d ' ') tareas accionables (ignore titulos/tablas/prosa)"
  else
    # Lista plana: quita blancos y comentarios, deja el resto verbatim.
    grep -vE '^[[:space:]]*($|#)' "$file" > "$tasks_file"
  fi

  local total; total=$(wc -l < "$tasks_file" | tr -d ' ')
  say "cola: $total tareas en $file"
  local done_file="$STATE/queue-$(echo "$PWD$file" | shasum | cut -c1-12).done"
  touch "$done_file"
  local n=0 ok=0
  # FD 3 (no stdin): asi lo que ejecute cada tarea no puede drenar la cola.
  while IFS= read -r line <&3; do
    # saltar lineas en blanco (aunque tengan solo espacios)
    [ -z "${line//[[:space:]]/}" ] && continue
    n=$(( n + 1 ))
    if grep -Fxq "$line" "$done_file"; then say "${c_dim}[$n] ya hecha, salto${c_off}"; continue; fi
    echo; say "${c_yel}[$n] $line${c_off}"
    if run_with_retries new "$line"; then
      echo "$line" >> "$done_file"; ok=$(( ok + 1 ))
    else
      say "corto la cola en la tarea $n"; break
    fi
  done 3< "$tasks_file"
  rm -f "$tasks_file"
  say "cola: $ok/$n completadas · progreso en $done_file"
}

case "${1:-status}" in
  status)   cmd_status ;;
  warm)     cmd_warm ;;
  unload)   cmd_unload ;;
  doctor)   cmd_doctor ;;
  serve)    cmd_serve ;;
  stop)     cmd_stop ;;
  logs)     tail -f "$STATE/logs/opencode-server.log" ;;
  sessions) shift; cmd_sessions "${1:-}" ;;
  tui)      ensure_model; shift; exec opencode --agent "$AGENT" -m "$MODEL_REF" "$@" ;;
  web)      ensure_model
            # opencode agrupa las sesiones por directorio: el web solo muestra
            # las de la carpeta desde la que lo abres. Si estas en HOME, avisa.
            [ "$PWD" = "$HOME" ] && say "${c_yel}estas en HOME; para ver las sesiones de un proyecto, abrelo desde su carpeta${c_off}"
            say "web en: $PWD"
            exec opencode web ;;
  run)      shift; run_with_retries new "$@" ;;
  cont)     shift; run_with_retries cont "$@" ;;
  queue)    shift; [ -n "${1:-}" ] || { echo "uso: qtask queue <archivo>" >&2; exit 1; }; cmd_queue "$1" ;;
  -h|--help|help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)        run_with_retries new "$@" ;;   # qtask "haz X" tambien funciona
esac
