# Variante afinada para agentes de codigo/CLI.
#
# __BASE_MODEL__ lo sustituye install.sh (por defecto el quant que le pases).
# Elige un quant que quepa CON MARGEN en tu limite de memoria de GPU:
# en un Mac de 24 GB eso significa ~13 GB de pesos, no 16 GB. Ver README.
FROM __BASE_MODEL__

# Muchos modelos de la comunidad vienen con presence_penalty alto (1.0-1.5).
# En prosa da variedad; en codigo es fatal, porque penaliza reusar el mismo
# identificador, import o palabra clave. Para un agente tiene que ser 0.
PARAMETER presence_penalty 0
PARAMETER frequency_penalty 0
PARAMETER repeat_penalty 1.05

# Sampling deterministico: los tool-calls y las ediciones de archivos no
# quieren creatividad, quieren que el JSON salga bien siempre.
PARAMETER temperature 0.15
PARAMETER top_p 0.8
PARAMETER top_k 20
PARAMETER min_p 0

# El KV cache es barato en modelos MoE con embedding pequeno (~0.7 GB por 49K
# tokens). El contexto largo no es lo que te tumba la GPU; los pesos si.
PARAMETER num_ctx __NUM_CTX__
